# Core
# Defaults to a local SQLite file. For Postgres from docker-compose:
# AIP_DATABASE_URL=postgresql+asyncpg://aip:aip@localhost:5432/aip
AIP_DATABASE_URL=sqlite+aiosqlite:///./aip.db
AIP_AUTO_CREATE_SCHEMA=true
AIP_DOCUMENT_DIR=var/documents

# Agents
# Claude via the Anthropic API (reads ANTHROPIC_API_KEY)...
AIP_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ...or Claude on Microsoft Foundry (Azure):
# AIP_LLM_PROVIDER=foundry
# AIP_FOUNDRY_RESOURCE=
# AIP_FOUNDRY_API_KEY=
AIP_LLM_MODEL=claude-opus-5-5

# Optional L2 response cache (otherwise in-process memory)
# AIP_REDIS_URL=redis://localhost:6379/0
